{
  "name": "@soundtouch/server",
  "version": "0.1.0",
  "description": "Backend server for the SoundTouch web interface",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "soundtouch-server": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@soundtouch/core": "workspace:*",
    "@soundtouch/api": "workspace:*",
    "@soundtouch/discovery": "workspace:*",
    "fastify": "^5",
    "@fastify/websocket": "^11",
    "@fastify/static": "^8",
    "@fastify/cors": "^10",
    "better-sqlite3": "^11",
    "yaml": "^2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7",
    "@types/node": "^20",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": ["dist"],
  "license": "MIT",
  "author": "Paul Grant"
}
